# ─────────────────────────────────────────────────────────────
# Operação Mundo — variáveis de ambiente do BACKEND
# Copie para `backend/.env` e ajuste. NUNCA versione o `.env`.
# ─────────────────────────────────────────────────────────────

# --- Banco de dados (Prisma + PostgreSQL) ---
# Deve bater com as credenciais e a porta do docker-compose.yml na raiz (host 5433).
DATABASE_URL="postgresql://mundo:mundo_dev@localhost:5433/operacao_mundo?schema=public"

# --- Servidor HTTP ---
PORT=3333
# CSV de origens liberadas no CORS (ex.: http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000
# "production" desliga as rotas de diagnóstico (/api/v1/dev/*).
NODE_ENV=development
# Atrás de proxy (Railway/AWS/Nginx): nº de proxies (ex.: 1) ou "true".
# Vazio = desligado (rodando local sem proxy). Necessário para o rate limit
# por IP funcionar corretamente atrás de um proxy.
TRUST_PROXY=
# Rate limit por IP+rota (janela deslizante).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Sessão / JWT ---
JWT_SECRET="troque-por-uma-chave-secreta-forte"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- Camada de IA (Agente 3) — adaptador universal ---
# Provedor ativo: "gemini" (padrão) ou "claude".
AI_PROVIDER=gemini
# Timeout por chamada de IA (ms). O gemini-3.6-flash usa "thinking" mínimo,
# então a resposta costuma levar alguns segundos (não < 1s como no 2.5-flash).
AI_TIMEOUT=15000
# Tentativas extras após a primeira falha.
AI_MAX_RETRIES=1
# Cache determinístico de respostas de IA (economiza cota do provedor e zera a
# latência em acerto). `false` desliga. TTL em segundos; MAX = teto de entradas.
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=86400
AI_CACHE_MAX=500

# Google Gemini (@google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic Claude (@anthropic-ai/sdk)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
