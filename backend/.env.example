# ─────────────────────────────────────────────────────────────
# Operação Mundo — variáveis de ambiente do BACKEND
# Copie para `backend/.env` e ajuste. NUNCA versione o `.env`.
# ─────────────────────────────────────────────────────────────

# --- Banco de dados (Prisma + PostgreSQL) ---
# Deve bater com as credenciais e a porta do docker-compose.yml na raiz (host 5433).
DATABASE_URL="postgresql://mundo:mundo_dev@localhost:5433/operacao_mundo?schema=public"

# --- Servidor HTTP ---
PORT=3333
# CSV de origens liberadas no CORS (ex.: http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# --- Sessão / JWT ---
JWT_SECRET="troque-por-uma-chave-secreta-forte"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- Camada de IA (Agente 3) — adaptador universal ---
# Provedor ativo: "gemini" (padrão) ou "claude".
AI_PROVIDER=gemini
# Timeout por chamada de IA (ms) — alvo de resposta < 800ms.
AI_TIMEOUT=8000
# Tentativas extras após a primeira falha.
AI_MAX_RETRIES=1

# Google Gemini (@google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (@anthropic-ai/sdk)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
